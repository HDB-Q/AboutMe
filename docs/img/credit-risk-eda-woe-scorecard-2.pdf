   "source": [
    "\n",
    "print(\"Weight of evidence - Decision Tree Classifier Binning\")\n",
    "woe_tree = bin_and_plot_woe_tree(df, 'total_rec_late_fee', 'loan_status_binary', max_depth=4)\n",
    "plot_woe_distribution_plotly(woe_tree, feature=\"total_rec_late_fee\", title=\"WOE (Decision Tree bins)\")"
   ]
  },
